# API (host cuando corrés Nest con npm; en Docker Compose api usa PORT del compose)
# Nest carga este archivo desde src/config/load-env.ts (paquete dotenv).
PORT=3000

# Postgres desde tu máquina (npm run start:dev): localhost + puerto publicado del contenedor db
DATABASE_HOST=localhost
DATABASE_PORT=5433

# En la red Docker el host es `db` y el puerto interno es 5432 (ya definido en docker-compose para el servicio api)
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=automotores

# true: TypeORM crea/ajusta tablas al iniciar (challenge / dev). En producción real usar migraciones y false.
DATABASE_SYNCHRONIZE=true
