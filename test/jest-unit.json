{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": ["<rootDir>/test/unit/**/*.spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^((?:\\./|\\.\\./).+)\\.js$": "$1"
  },
  "collectCoverageFrom": [
    "<rootDir>/src/**/*.(t|j)s",
    "!<rootDir>/src/**/*.spec.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage",
  "testEnvironment": "node"
}
