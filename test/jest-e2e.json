{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": ["<rootDir>/test/e2e/**/*.e2e-spec.ts"],
  "setupFiles": ["<rootDir>/test/setup-e2e.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^((?:\\./|\\.\\./).+)\\.js$": "$1"
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1
}
